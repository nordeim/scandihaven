# ---- Database (PostgreSQL 17) ----
# Local dev: `docker compose up -d` creates this database, or point to your own PG17.
DATABASE_URL=postgresql://scandihaven_user:scandihaven_secret@localhost:5432/scandihaven_dev

# ---- Better Auth ----
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="Ked6tmOeT8FFwmUJ5bxBsEyT+DRqbeb2P61aU2nO8qA="
# MUST be the canonical PUBLIC origin in production (behind a reverse proxy,
# a localhost value breaks sign-in with "Invalid origin" — audit H-AUTH).
# Additional origins for the trusted set (comma-separated, native
# BETTER_AUTH_TRUSTED_ORIGINS); the origin each request is served on is
# always derived server-side from proxy-controlled headers.
BETTER_AUTH_URL=http://localhost:3000
#BETTER_AUTH_TRUSTED_ORIGINS=https://scandihaven.example,https://admin.scandihaven.example

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe (test mode for dev) ----
# https://dashboard.stripe.com/test/apikeys — never commit real keys.
STRIPE_SECRET_KEY=sk_test_set-me
STRIPE_WEBHOOK_SECRET=whsec_set-me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_set-me

# ---- Transactional email (optional in dev; log transport used when unset) ----
RESEND_API_KEY=
EMAIL_FROM="Scandi Haven <orders@scandihaven.example>"

# ---- Cron / jobs runner ----
# Generate: openssl rand -hex 16
CRON_SECRET="df3eac0e041e154443099c58c9866d87"

# ---- OAuth (optional in dev) ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ---- Feature flags (PRD §4.8; unknown FEATURE_* vars fail fast at boot) ----
# Values: on/off (also true/false, 1/0). Defaults when unset: TRADE off,
# GIFT_CARDS off, REVIEWS on, I18N on, KLARNA off.
# FEATURE_TRADE=off
# FEATURE_GIFT_CARDS=off
# FEATURE_REVIEWS=on
# FEATURE_I18N=on
# FEATURE_KLARNA=off

# ---- Image pipeline (local/E2E only; production keeps optimization on) ----
# The sharp optimizer can deadlock in constrained sandboxes — set to 1 to
# serve images unoptimized. Must stay listed in turbo.json globalEnv.
DISABLE_IMAGE_OPTIMIZER=
